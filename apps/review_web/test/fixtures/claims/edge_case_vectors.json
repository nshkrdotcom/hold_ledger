{
  "evidence_tier": "source_inspection_expectations_not_executed",
  "purpose": "Turn binder provenance, source-drift, optional follow-on, and invalid-draft hazards into concrete milestone tests.",
  "binder_cases": [
    {
      "law": "po_a2",
      "operation": "request",
      "fixture": "P04",
      "expected_parameter_origins": {
        "s": "before_state",
        "key": "request_event.key",
        "amount": "request_event.amount"
      },
      "expected_input_domain": "request_eligible on fresh key",
      "entry_lookup_required": false
    },
    {
      "law": "po_a4_conflict",
      "operation": "request",
      "before": {
        "amount_limit": 100,
        "hold_limit": 2,
        "used_amount": 50,
        "used_holds": 1,
        "entries": [
          {
            "key": 1,
            "amount": 50,
            "status": "reserved"
          }
        ]
      },
      "event": {
        "type": "request",
        "key": 1,
        "amount": 60
      },
      "expected_parameter_values": {
        "key": 1,
        "amount": 60,
        "original": 50,
        "status": "reserved"
      },
      "expected_parameter_origins": {
        "s": "before_state",
        "key": "request_event.key_and_entry_key",
        "amount": "request_event.amount",
        "original": "existing_entry.amount",
        "status": "existing_entry.status"
      },
      "requires_relational_constraint": "request amount != existing original",
      "expected_domain_from_source": true
    },
    {
      "law": "po_a4_duplicate",
      "operation": "request",
      "before": {
        "amount_limit": 100,
        "hold_limit": 2,
        "used_amount": 50,
        "used_holds": 1,
        "entries": [
          {
            "key": 1,
            "amount": 50,
            "status": "reserved"
          }
        ]
      },
      "event": {
        "type": "request",
        "key": 1,
        "amount": 50
      },
      "expected_parameter_values": {
        "key": 1,
        "amount": 50,
        "status": "reserved"
      },
      "expected_parameter_origins": {
        "s": "before_state",
        "key": "request_event.key_and_entry_key",
        "amount": "request_event.amount_equal_to_existing_entry.amount",
        "status": "existing_entry.status"
      },
      "requires_relational_constraint": "request amount == lookup amount",
      "expected_domain_from_source": true
    },
    {
      "law": "po_exposure_retain",
      "operation": "step",
      "fixture": "P07",
      "expected_entry_bindings": [
        {
          "key": 1,
          "amount": 50,
          "status": "authorized"
        },
        {
          "key": 2,
          "amount": 100,
          "status": "sent"
        }
      ],
      "expected_parameter_origins": {
        "state": "before_state",
        "event": "witness_event",
        "key": "existing_entry.key",
        "amount": "existing_entry.amount",
        "status": "existing_entry.status"
      },
      "expected_complete_for_valid_bounded_entry_list": true,
      "key_can_differ_from_event_key": true
    },
    {
      "law": "po_b2",
      "operation": "step",
      "fixture": "P06",
      "expected_parameter_origins": {
        "s": "before_state",
        "event": "witness_event",
        "key": "existing_unknown_entry.key",
        "amount": "existing_unknown_entry.amount"
      },
      "expected_domain_on_pre_state_sent_entry": false,
      "requires_relational_constraint": "lookup(key) status == unknown; event key need not equal bound key"
    },
    {
      "law": "l3_accounting",
      "operation": "set_status",
      "expected_step_pointwise_adapter": false,
      "expected_parameter_origins": {
        "entries": "separate_list_argument",
        "key": "entry_lookup.key",
        "amount": "entry_lookup.amount",
        "from": "entry_lookup.status",
        "to": "target_status"
      }
    }
