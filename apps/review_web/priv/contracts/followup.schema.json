{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_kind",
    "card_id",
    "question",
    "possible_intent_revision",
    "explanation",
    "source_ids",
    "uncertainty"
  ],
  "properties": {
    "request_kind": {
      "const": "followup"
    },
    "card_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "possible_intent_revision": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    },
    "explanation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "uncertainty": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 600
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hold Ledger followup structured output"
}
