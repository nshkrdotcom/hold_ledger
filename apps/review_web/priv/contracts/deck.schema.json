{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_kind",
    "target_node_id",
    "intent_hypotheses",
    "readings",
    "card_suggestions",
    "uncertainties"
  ],
  "properties": {
    "request_kind": {
      "const": "deck"
    },
    "target_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "intent_hypotheses": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "intent_id",
          "statement",
          "why_plausible",
          "distinguishing_question",
          "source_ids"
        ],
        "properties": {
          "intent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "why_plausible": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "distinguishing_question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        }
      }
    },
    "readings": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_slug",
          "summary",
          "not_claimed",
          "source_ids",
          "predictions"
        ],
        "properties": {
          "claim_slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "not_claimed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          },
          "predictions": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "probe_id",
                "predicted_status",
                "explanation"
              ],
              "properties": {
                "probe_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "predicted_status": {
                  "enum": [
                    "catches",
                    "allows_here",
                    "does_not_apply",
                    "cant_check"
                  ]
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          }
        }
      }
    },
    "card_suggestions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "proposal_id",
          "kind",
          "target_node_id",
          "question",
          "selection_reason",
          "source_ids",
          "probe_ids"
        ],
        "properties": {
          "proposal_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "kind": {
            "enum": [
              "reading",
              "escape",
              "silence",
              "assumption",
              "trace"
            ]
          },
          "target_node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          },
          "probe_ids": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "missing_evidence",
          "source_ids"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "missing_evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hold Ledger deck structured output"
}
