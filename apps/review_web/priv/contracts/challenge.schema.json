{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_kind",
    "target_card_id",
    "witness",
    "selection_reason",
    "source_ids"
  ],
  "properties": {
    "request_kind": {
      "const": "challenge"
    },
    "target_card_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "event",
        "output",
        "follow_on"
      ],
      "properties": {
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount_limit",
            "hold_limit",
            "used_amount",
            "used_holds",
            "entries"
          ],
          "properties": {
            "amount_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "hold_limit": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "used_amount": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "used_holds": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "entries": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "amount",
                  "status"
                ],
                "properties": {
                  "key": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000
                  },
                  "status": {
                    "enum": [
                      "reserved",
                      "sent",
                      "unknown",
                      "authorized",
                      "voiding",
                      "declined",
                      "voided"
                    ]
                  }
                }
              }
            }
          }
        },
        "event": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key",
                "amount"
              ],
              "properties": {
                "type": {
                  "const": "request"
                },
                "key": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "amount": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key",
                "amount"
              ],
              "properties": {
                "type": {
                  "const": "dispatch"
                },
                "key": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "amount": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key",
                "amount"
              ],
              "properties": {
                "type": {
                  "const": "timeout"
                },
                "key": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "amount": {
                  "type": "null"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "key",
                "amount"
              ],
              "properties": {
                "type": {
                  "const": "void"
                },
                "key": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "amount": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "after",
            "result",
            "effects"
          ],
          "properties": {
            "after": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount_limit",
                "hold_limit",
                "used_amount",
                "used_holds",
                "entries"
              ],
              "properties": {
                "amount_limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "hold_limit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "used_amount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "used_holds": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "entries": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "key",
                      "amount",
                      "status"
                    ],
                    "properties": {
                      "key": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      },
                      "status": {
                        "enum": [
                          "reserved",
                          "sent",
                          "unknown",
                          "authorized",
                          "voiding",
                          "declined",
                          "voided"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "result": {
              "enum": [
                "admitted",
                "insufficient_holds",
                "insufficient_amount",
                "duplicate",
                "conflict",
                "dispatched",
                "marked_unknown",
                "restarted",
                "retried",
                "authorized",
                "declined",
                "voiding",
                "voided",
                "stale",
                "not_found",
                "malformed"
              ]
            },
            "effects": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "key",
                      "amount"
                    ],
                    "properties": {
                      "type": {
                        "const": "void"
                      },
                      "key": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "amount": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "key",
                      "amount"
                    ],
                    "properties": {
                      "type": {
                        "const": "authorize"
                      },
                      "key": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000000
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1000000
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "follow_on": {
          "anyOf": [
            {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "key",
                    "amount"
                  ],
                  "properties": {
                    "type": {
                      "const": "request"
                    },
                    "key": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000000
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "key",
                    "amount"
                  ],
                  "properties": {
                    "type": {
                      "const": "dispatch"
                    },
                    "key": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "amount": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "key",
                    "amount"
                  ],
                  "properties": {
                    "type": {
                      "const": "timeout"
                    },
                    "key": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "amount": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "key",
                    "amount"
                  ],
                  "properties": {
                    "type": {
                      "const": "void"
                    },
                    "key": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000
                    },
                    "amount": {
                      "type": "null"
                    }
                  }
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hold Ledger challenge structured output (structural only)"
}
