+/-- Extract the same import edges that verification will use, including prelude headers. -/
+private def planFiles (j : Json) (cache : IO.Ref (Option Runtime)) (emit : Json → IO Unit) : IO Unit := do
+  let files ← IO.ofExcept (arr j "files")
