+      unless imports.contains imported.module.toString do
+        imports := imports.push imported.module.toString
+    nodes := nodes.push (Json.mkObj [("module", toJson name), ("imports", toJson imports)])
+  emit (Json.mkObj [("status", toJson "plan"), ("nodes", Json.arr nodes)])
+
+/-- Export only the complete registry of modules compiled by the current coordinator. -/
+private def exportArtifacts (j : Json) (cache : IO.Ref (Option Runtime)) : IO Unit := do
+  let runtime ← getRuntime cache
+  let mut artifacts : NameMap ImportArtifacts := {}
+  let mut modules := #[]
+  for input in ← IO.ofExcept (arr j "artifact_inputs") do
+    let name ← IO.ofExcept (str input "module")
+    let moduleName ← IO.ofExcept <| (identifier name).run runtime.env |>.run' {}
+    let path := System.FilePath.mk (← IO.ofExcept (str input "directory"))
+    artifacts := artifacts.insert moduleName.getId (cachedArtifacts path)
+    modules := modules.push moduleName.getId
+  let path := System.FilePath.mk (← IO.ofExcept (str j "export"))
+  IO.FS.withTempDir fun temporary => exportModules path modules artifacts temporary
 
 private def run (request : String) (cache : IO.Ref (Option Runtime)) (emit : Json → IO Unit) : IO Unit := do
   try
     let j ← IO.ofExcept (Json.parse request)
     let command ← IO.ofExcept (str j "command")
     let version ← IO.ofExcept (str j "version")
-    unless version == "1.0" do throw (IO.userError "unsupported version")
-    unless command == "verify" do throw (IO.userError s!"unsupported runner command '{command}'")
-    runFiles j cache emit
+    unless version == "2.0" do throw (IO.userError "unsupported version")
+    match command with
+    | "verify" => runFiles j cache emit
+    | "plan" => planFiles j cache emit
+    | "export" => exportArtifacts j cache
+    | _ => throw (IO.userError s!"unsupported runner command '{command}'")
     emit (Json.mkObj [("status", toJson "done")])
   catch err =>
     emit (Json.mkObj [("status", toJson "failure"), ("message", toJson err.toString)])
